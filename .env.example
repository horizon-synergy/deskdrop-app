# DeskDrop — local development environment
#
# Copy this file to `.env.local` and fill in the values for your own Firebase
# project and Cloudinary account. `.env.local` is gitignored and must never be
# committed.
#
# Every variable here is VITE_-prefixed, which means Vite inlines it into the
# JavaScript bundle and it is therefore visible to anyone who loads the site.
# That is expected: these are public client identifiers, not credentials.
#   - The Firebase web API key identifies the project to Google's APIs. It
#     grants no access by itself — access is enforced by the Firestore security
#     rules in firestore.rules and by the authorized domains configured in the
#     Firebase console.
#   - The Cloudinary cloud name and unsigned upload preset are designed for
#     browser use. The Cloudinary API secret is NEVER used in this app and must
#     never be added here; doing so would ship it to every visitor.
#
# In production these are set as environment variables in the Netlify UI
# (Site configuration -> Environment variables) rather than in any file.

# Firebase web app config (Firebase console -> Project settings -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — only needed if you want Google Analytics enabled.
VITE_FIREBASE_MEASUREMENT_ID=

# Cloudinary (Cloudinary console -> Settings -> Upload -> Upload presets).
# The preset must be UNSIGNED and restricted to image formats with a size cap.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
